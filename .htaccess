# ==========================================================
# ServEasy Backend Security & Routing Configuration
# ==========================================================
Options -Indexes
DirectoryIndex index.php

# Block sensitive configuration and log files
<FilesMatch "(\.env|\.env\..*|\.log|\.sql|\.git|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Enable Global Cross-Origin Resource Sharing (CORS)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-Token, X-Requested-With, X-Customer-Id, X-Provider-Id, Accept, Origin"
</IfModule>

# URL Rewriting for flexible API routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ensure Authorization header is forwarded to PHP on LiteSpeed/Apache CGI
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Respond 200 OK to OPTIONS preflight requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

    # If endpoint called without /api/, forward to api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/api/$1 -f
    RewriteRule ^(.*\.php)$ api/$1 [L,QSA]
</IfModule>
