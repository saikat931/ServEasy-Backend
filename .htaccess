# ==========================================================
# ServEasy Backend Security & Routing Configuration
# ==========================================================
Options -Indexes
DirectoryIndex index.php

# Block sensitive configuration and log files
<FilesMatch "(\.env|\.env\..*|\.log|\.sql|\.git|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Note: Dynamic CORS headers (exact Origin + Credentials: true) and OPTIONS preflight
# are handled by api/bootstrap.php so cross-domain fetch() with credentials:'include' succeeds in all browsers.

# URL Rewriting for flexible API routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ensure Authorization header is forwarded to PHP on LiteSpeed/Apache CGI
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # If endpoint called without /api/, forward to api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/api/$1 -f
    RewriteRule ^(.*\.php)$ api/$1 [L,QSA]
</IfModule>
